                CardStroke,
                TweenInfo.new(0.2),
                {
                    Color = Color3.fromRGB(0, 140, 255)
                }
            ):Play()

            if onEnable then
                pcall(onEnable)
            end

        else

            TweenService:Create(
                ToggleBg,
                TweenInfo.new(0.2),
                {
                    BackgroundColor3 = Color3.fromRGB(40, 50, 70)
