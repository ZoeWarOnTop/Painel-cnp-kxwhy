--=======================================================
-- AUDIO EQUALIZER
--=======================================================

local audioConnection

local function ApplyAudio(sound)

    if not sound:IsA("Sound") then
        return
    end

    if sound:FindFirstChild("CNP_AudioMarker") then
        return
    end

    local marker = Instance.new("BoolValue")
    marker.Name = "CNP_AudioMarker"
    marker.Parent = sound

    sound.Volume = 1

    local equalizer = Instance.new("EqualizerSoundEffect")
    equalizer.Name = "CNP_Equalizer"
    equalizer.LowGain = 5
    equalizer.MidGain = -12
    equalizer.HighGain = 5
    equalizer.Parent = sound

    local compressor = Instance.new("CompressorSoundEffect")
    compressor.Name = "CNP_Compressor"
    compressor.Threshold = -20
    compressor.Ratio = 4
    compressor.Attack = 0.01
    compressor.Parent = sound
end

AddToggleScript(
    "Audio Equalizer",
    "Applies equalizer and compression to game sounds.",
    function()

        for _, object in ipairs(game:GetDescendants()) do
            ApplyAudio(object)
        end

        audioConnection = game.DescendantAdded:Connect(ApplyAudio)
    end,
    function()

        if audioConnection then
            audioConnection:Disconnect()
            audioConnection = nil
        end

        for _, object in ipairs(game:GetDescendants()) do

            if object:IsA("Sound") then

                local marker = object:FindFirstChild("CNP_AudioMarker")
                if marker then
                    marker:Destroy()
                end

                local equalizer = object:FindFirstChild("CNP_Equalizer")
                if equalizer then
                    equalizer:Destroy()
                end

                local compressor = object:FindFirstChild("CNP_Compressor")
                if compressor then
                    compressor:Destroy()
                end
            end
        end
    end
)

