-- OPTION CREATOR
--==================================================

local States = {}

local function CreateOption(Name, Callback)

    local Card = Instance.new("Frame")
    Card.Size = UDim2.new(1, -4, 0, 52)
    Card.BackgroundColor3 = Color3.fromRGB(13, 28, 48)
    Card.BorderSizePixel = 0
    Card.Active = false
    Card.Parent = Scroll

    Instance.new("UICorner", Card).CornerRadius = UDim.new(0, 10)

    local Stroke = Instance.new("UIStroke")
    Stroke.Color = Color3.fromRGB(25, 70, 120)
    Stroke.Thickness = 1
    Stroke.Transparency = 0.25
    Stroke.Parent = Card

    local Label = Instance.new("TextLabel")
    Label.Size = UDim2.new(1, -95, 1, 0)
    Label.Position = UDim2.new(0, 14, 0, 0)
    Label.BackgroundTransparency = 1
    Label.Text = Name
    Label.TextColor3 = Color3.fromRGB(210, 225, 245)
    Label.TextSize = 14
    Label.Font = Enum.Font.GothamMedium
    Label.TextXAlignment = Enum.TextXAlignment.Left
    Label.Active = false
    Label.Parent = Card

    local Button = Instance.new("TextButton")
    Button.Size = UDim2.new(0, 68, 0, 30)
    Button.Position = UDim2.new(1, -80, 0.5, -15)
    Button.BackgroundColor3 = Color3.fromRGB(120, 35, 45)
    Button.Text = "OFF"
    Button.TextColor3 = Color3.fromRGB(255, 220, 220)
    Button.TextSize = 12
    Button.Font = Enum.Font.GothamBold
    Button.BorderSizePixel = 0
    Button.Active = true
    Button.Parent = Card

    Instance.new("UICorner", Button).CornerRadius = UDim.new(0, 8)

    States[Name] = false

    Button.Activated:Connect(function()

        States[Name] = not States[Name]

        if States[Name] then

            Button.BackgroundColor3 = Color3.fromRGB(35, 110, 205)
            Button.TextColor3 = Color3.fromRGB(235, 250, 255)
            Button.Text = "ON"

            Callback(true)

        else

            Button.BackgroundColor3 = Color3.fromRGB(120, 35, 45)
            Button.TextColor3 = Color3.fromRGB(255, 220, 220)
            Button.Text = "OFF"

            Callback(false)

        end

    end)

    return Card, Button
end

--==================================================
-- CHARACTER HELPERS
--==================================================

local function GetCharacter()
    return LocalPlayer.Character
end

local function GetRoot()
    local Character = GetCharacter()

    if not Character then
        return nil
    end

    return Character:FindFirstChild("HumanoidRootPart")
end

local function GetHumanoid()
    local Character = GetCharacter()

    if not Character then
        return nil
    end

    return Character:FindFirstChildOfClass("Humanoid")
end

