-- SHIFT LOCK OFFSET
--==================================================

local ShiftLockConnection

CreateOption("Shift Lock Offset", function(Enabled)

    if ShiftLockConnection then
        ShiftLockConnection:Disconnect()
        ShiftLockConnection = nil
    end

    if not Enabled then

        local Humanoid = GetHumanoid()

        if Humanoid then
            Humanoid.CameraOffset = Vector3.zero
        end

        return
    end

    pcall(function()
        Workspace.Retargeting = Enum.AnimatorRetargetingMode.Disabled
    end)

    ShiftLockConnection = RunService.RenderStepped:Connect(function()

        local Humanoid = GetHumanoid()

        if Humanoid then

            if UIS.MouseBehavior == Enum.MouseBehavior.LockCenter then
                Humanoid.CameraOffset = Vector3.new(1.2, 0.8, 0)
            else
                Humanoid.CameraOffset = Vector3.zero
            end

        end

    end)

end)

--==================================================
-- WATER JUMP
--==================================================

local WaterJumpConnection

CreateOption("Water Jump", function(Enabled)

    if WaterJumpConnection then
        WaterJumpConnection:Disconnect()
        WaterJumpConnection = nil
    end

    if not Enabled then
        return
    end

    WaterJumpConnection = UIS.JumpRequest:Connect(function()

        local Humanoid = GetHumanoid()
        local Root = GetRoot()

        if Humanoid
            and Root
            and Humanoid:GetState() == Enum.HumanoidStateType.Swimming then

            Root.AssemblyLinearVelocity = Vector3.new(
                Root.AssemblyLinearVelocity.X,
                200,
                Root.AssemblyLinearVelocity.Z
            )

        end

    end)

end)

--==================================================
-- SLOPE JUMP BOOST
--==================================================

local SlopeConnection

CreateOption("Slope Jump Boost", function(Enabled)

    if SlopeConnection then
        SlopeConnection:Disconnect()
        SlopeConnection = nil
    end

    if not Enabled then
        return
    end

    SlopeConnection = RunService.RenderStepped:Connect(function()

        local Humanoid = GetHumanoid()
        local Root = GetRoot()

        if not Humanoid or not Root then
            return
        end

        if UIS:IsKeyDown(Enum.KeyCode.S)
            and (
                UIS:IsKeyDown(Enum.KeyCode.A)
                or UIS:IsKeyDown(Enum.KeyCode.D)
            )
            and Root.CFrame.UpVector.Y < 0.7
            and Humanoid:GetState() == Enum.HumanoidStateType.Jumping then

            Root.AssemblyLinearVelocity = Vector3.new(
                Root.AssemblyLinearVelocity.X,
                170,
                Root.AssemblyLinearVelocity.Z
            )

        end

    end)

end)

