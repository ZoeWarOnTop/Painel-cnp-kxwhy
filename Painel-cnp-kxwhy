-- SHIFT LOCK OFFSET
--=======================================================

local shiftOffsetEnabled = false
local shiftOffset = Vector3.new(1.2, 0.8, 0)
local normalOffset = Vector3.new(0, 0, 0)

local currentHumanoid

pcall(function()
    Workspace.Retargeting = Enum.AnimatorRetargetingMode.Disabled
end)

local function SetupShiftCharacter(character)

    currentHumanoid = character:WaitForChild("Humanoid")

    currentHumanoid.CameraOffset = normalOffset

    if shiftOffsetEnabled then
        currentHumanoid.CameraOffset = shiftOffset
    end
end

if LocalPlayer.Character then
    SetupShiftCharacter(LocalPlayer.Character)
end

LocalPlayer.CharacterAdded:Connect(SetupShiftCharacter)

RunService.RenderStepped:Connect(function()

    if not shiftOffsetEnabled then
        return
    end

    if not currentHumanoid then
        return
    end

    if UserInputService.MouseBehavior == Enum.MouseBehavior.LockCenter then
        currentHumanoid.CameraOffset = shiftOffset
    else
        currentHumanoid.CameraOffset = normalOffset
    end
end)

AddToggleScript(
    "Shift Lock Offset",
    "Moves the camera position while Shift Lock is active.",
    function()
        shiftOffsetEnabled = true
    end,
    function()
        shiftOffsetEnabled = false

        if currentHumanoid then
            currentHumanoid.CameraOffset = normalOffset
        end
    end
)

