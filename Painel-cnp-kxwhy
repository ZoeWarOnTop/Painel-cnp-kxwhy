--=======================================================
-- SLOPE BOOST
--=======================================================

local slopeBoostEnabled = false
local SLOPE_BOOST = 170
local holdingS = false
local holdingAorD = false

UserInputService.InputBegan:Connect(function(input)

    if input.KeyCode == Enum.KeyCode.S then
        holdingS = true
    end

    if input.KeyCode == Enum.KeyCode.A
        or input.KeyCode == Enum.KeyCode.D then

        holdingAorD = true
    end
end)

UserInputService.InputEnded:Connect(function(input)

    if input.KeyCode == Enum.KeyCode.S then
        holdingS = false
    end

    if input.KeyCode == Enum.KeyCode.A
        or input.KeyCode == Enum.KeyCode.D then

        holdingAorD = false
    end
end)

local function SetupSlopeCharacter(character)

    local humanoid = character:WaitForChild("Humanoid")
    local rootPart = character:WaitForChild("HumanoidRootPart")

    humanoid.Jumping:Connect(function()

        if not slopeBoostEnabled then
            return
        end

        local inclined = rootPart.CFrame.UpVector.Y < 0.7

        if inclined and holdingS and holdingAorD then

            rootPart.AssemblyLinearVelocity = Vector3.new(
                0,
                SLOPE_BOOST,
                0
            )
        end
    end)
end

if LocalPlayer.Character then
    SetupSlopeCharacter(LocalPlayer.Character)
end

LocalPlayer.CharacterAdded:Connect(SetupSlopeCharacter)

AddToggleScript(
    "Slope Jump Boost",
    "Boosts jumping while moving backward on an incline.",
    function()
        slopeBoostEnabled = true
    end,
    function()
        slopeBoostEnabled = false
    end
)

