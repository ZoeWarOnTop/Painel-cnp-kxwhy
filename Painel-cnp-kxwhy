--==================================================
-- AUDIO EQUALIZER
--==================================================

local EqualizerObjects = {}
local SoundDescendantConnection

local function ApplyEqualizer(Sound)

    if not Sound:IsA("Sound") then
        return
    end

    if EqualizerObjects[Sound] then
        return
    end

    local Equalizer = Instance.new("EqualizerSoundEffect")
    Equalizer.Name = "CNP_Equalizer"
    Equalizer.LowGain = 5
    Equalizer.MidGain = -12
    Equalizer.HighGain = 5
    Equalizer.Parent = Sound

    local Compressor = Instance.new("CompressorSoundEffect")
    Compressor.Name = "CNP_Compressor"
    Compressor.Threshold = -20
    Compressor.Ratio = 4
    Compressor.Attack = 0.01
    Compressor.Parent = Sound

    EqualizerObjects[Sound] = {
        Equalizer = Equalizer,
        Compressor = Compressor
    }

end

local function RemoveEqualizer(Sound)

    local Data = EqualizerObjects[Sound]

    if not Data then
        return
    end

    if Data.Equalizer then
        Data.Equalizer:Destroy()
    end

    if Data.Compressor then
        Data.Compressor:Destroy()
    end

    EqualizerObjects[Sound] = nil

end

CreateOption("Audio Equalizer", function(Enabled)

    if SoundDescendantConnection then
        SoundDescendantConnection:Disconnect()
        SoundDescendantConnection = nil
    end

    if Enabled then

        for _, Object in ipairs(game:GetDescendants()) do

            if Object:IsA("Sound") then
                ApplyEqualizer(Object)
            end

        end

        SoundDescendantConnection = game.DescendantAdded:Connect(function(Object)

            if States["Audio Equalizer"] and Object:IsA("Sound") then
                task.wait()
                ApplyEqualizer(Object)
            end

        end)

    else

        for Sound in pairs(EqualizerObjects) do
            RemoveEqualizer(Sound)
        end

    end

end)

