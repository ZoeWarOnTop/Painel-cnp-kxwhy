--=======================================================
-- MM2 2024 LIGHTING
--=======================================================

local lightingBackup = {}
local lightBackup = {}
local colorCorrectionEffect

AddToggleScript(
    "MM2 2024 Final Lighting",
    "Applies the MM2 2024 lighting style with softer shadows.",
    function()

        lightingBackup = {
            Technology = Lighting.Technology,
            GlobalShadows = Lighting.GlobalShadows,
            ShadowSoftness = Lighting.ShadowSoftness,
            Brightness = Lighting.Brightness,
            ExposureCompensation = Lighting.ExposureCompensation,
            EnvironmentDiffuseScale = Lighting.EnvironmentDiffuseScale,
            EnvironmentSpecularScale = Lighting.EnvironmentSpecularScale,
            Ambient = Lighting.Ambient,
            OutdoorAmbient = Lighting.OutdoorAmbient,
            FogStart = Lighting.FogStart,
            FogEnd = Lighting.FogEnd
        }

        Lighting.Technology = Enum.Technology.Future
        Lighting.GlobalShadows = true
        Lighting.ShadowSoftness = 0.08
        Lighting.Brightness = 2.05
        Lighting.ExposureCompensation = 0.035
        Lighting.EnvironmentDiffuseScale = 0.18
        Lighting.EnvironmentSpecularScale = 0
        Lighting.Ambient = Color3.fromRGB(176, 176, 176)
        Lighting.OutdoorAmbient = Color3.fromRGB(162, 162, 162)
        Lighting.FogStart = 0
        Lighting.FogEnd = 100000

        local atmosphere = Lighting:FindFirstChildOfClass("Atmosphere")

        if atmosphere then
            atmosphere:Destroy()
        end

        for _, effect in ipairs(Lighting:GetChildren()) do

            if effect:IsA("BloomEffect")
                or effect:IsA("SunRaysEffect")
                or effect:IsA("BlurEffect")
                or effect:IsA("DepthOfFieldEffect") then

                effect:Destroy()
            end
        end

        colorCorrectionEffect = Instance.new("ColorCorrectionEffect")
        colorCorrectionEffect.Name = "CNP_MM22024_Final"
        colorCorrectionEffect.Saturation = -0.012
        colorCorrectionEffect.Contrast = 0.012
        colorCorrectionEffect.Brightness = 0.012
        colorCorrectionEffect.Parent = Lighting

        local terrain = Workspace:FindFirstChildOfClass("Terrain")

        if terrain then
            terrain.WaterWaveSize = 0
            terrain.WaterWaveSpeed = 0
            terrain.WaterReflectance = 0
            terrain.WaterTransparency = 0.2
        end

        lightBackup = {}

        local params = RaycastParams.new()
        params.FilterType = Enum.RaycastFilterType.Blacklist
        params.FilterDescendantsInstances = {}

        local function IsOutside(position)

            local result = Workspace:Raycast(
                position,
                Vector3.new(0, 120, 0),
                params
            )

            return result == nil
        end

        for _, light in ipairs(Workspace:GetDescendants()) do

            if light:IsA("PointLight")
                or light:IsA("SpotLight")
                or light:IsA("SurfaceLight") then

                local parent = light.Parent

                if parent and parent:IsA("BasePart") then

                    lightBackup[light] = {
                        Color = light.Color,
                        Shadows = light.Shadows,
                        Brightness = light.Brightness,
                        Range = light.Range,
                        Angle = light:IsA("SurfaceLight") and light.Angle or nil
                    }

                    local outside = IsOutside(parent.Position)

                    if light.Color.R > 0.95
                        and light.Color.G > 0.95
                        and light.Color.B > 0.95 then

                        light.Color = Color3.fromRGB(
                            240,
                            240,
                            236
                        )
                    end

                    light.Shadows = light.Brightness > 1.15

                    if not outside then

                        light.Brightness = math.clamp(
                            light.Brightness,
                            0.95,
                            1.22
                        )

                        light.Range = math.clamp(
                            light.Range,
                            0,
                            10
                        )

                        if light:IsA("SurfaceLight") then
                            light.Brightness *= 0.68
                            light.Range *= 0.72
                            light.Angle = math.min(
                                light.Angle,
                                82
                            )
                        end

                    else

                        light.Brightness = math.clamp(
                            light.Brightness,
                            0.86,
                            1.08
                        )

                        light.Range = math.clamp(
                            light.Range,
                            0,
                            11
                        )

                        if light:IsA("SurfaceLight") then
                            light.Brightness *= 0.86
                            light.Range *= 0.9
                        end
                    end

                    if light.Color.B > light.Color.R
                        or light.Color.G > light.Color.R then

                        light.Range *= 0.72
                        light.Brightness *= 0.9
                    end
                end
            end
        end

        for _, object in ipairs(Workspace:GetDescendants()) do

            if object:IsA("BasePart") then

                if object.Material == Enum.Material.Metal then

                    if not lightBackup[object] then
                        lightBackup[object] = {
                            Reflectance = object.Reflectance
                        }
                    end

                    object.Reflectance = math.min(
                        object.Reflectance,
                        0.012
                    )

                elseif object.Material == Enum.Material.SmoothPlastic
                    or object.Material == Enum.Material.Neon then

                    if not lightBackup[object] then
                        lightBackup[object] = {
                            Reflectance = object.Reflectance
                        }
                    end

                    object.Reflectance = 0
                end
            end
        end
    end,
    function()

        for object, data in pairs(lightBackup) do

            if object and object.Parent then

                if data.Color then
                    object.Color = data.Color
                    object.Shadows = data.Shadows
                    object.Brightness = data.Brightness
                    object.Range = data.Range

                    if object:IsA("SurfaceLight")
                        and data.Angle then

                        object.Angle = data.Angle
                    end
                end

                if data.Reflectance ~= nil then
                    object.Reflectance = data.Reflectance
                end
            end
        end

        lightBackup = {}

        if colorCorrectionEffect then
            colorCorrectionEffect:Destroy()
            colorCorrectionEffect = nil
        end

        if lightingBackup.Technology then

            Lighting.Technology = lightingBackup.Technology
            Lighting.GlobalShadows = lightingBackup.GlobalShadows
            Lighting.ShadowSoftness = lightingBackup.ShadowSoftness
            Lighting.Brightness = lightingBackup.Brightness
            Lighting.ExposureCompensation = lightingBackup.ExposureCompensation
            Lighting.EnvironmentDiffuseScale = lightingBackup.EnvironmentDiffuseScale
            Lighting.EnvironmentSpecularScale = lightingBackup.EnvironmentSpecularScale
            Lighting.Ambient = lightingBackup.Ambient
