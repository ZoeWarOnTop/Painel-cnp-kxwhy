-- ALEKS SPEED GLITCH
--==================================================

local MaxLimit = 50
local CurrentWeight = 20.6
local WeightName = "CoMWeight_Object"
local OffsetAmount = Vector3.new(0, 0, 6)

local AleksEnabled = false

local function ApplyPhysicsWeight(MassValue)

    local Character = LocalPlayer.Character

    if not Character then
        return
    end

    local Root = Character:FindFirstChild("HumanoidRootPart")

    if not Root then
        return
    end

    local Existing = Character:FindFirstChild(WeightName)

    if Existing then
        Existing:Destroy()
    end

    if MassValue > 0 then

        local Weight = Instance.new("Part")

        Weight.Name = WeightName
        Weight.Size = Vector3.new(1, 1, 1)
        Weight.Transparency = 1
        Weight.CanCollide = false
        Weight.CanQuery = false
        Weight.CanTouch = false
        Weight.Massless = false
        Weight.CustomPhysicalProperties = PhysicalProperties.new(
            MassValue,
            0.3,
            0.5
        )

        Weight.Parent = Character

        local Weld = Instance.new("Weld")

        Weld.Part0 = Root
        Weld.Part1 = Weight
        Weld.C0 = CFrame.new(OffsetAmount)
        Weld.Parent = Weight

    end

end

local function RemovePhysicsWeight()

    local Character = LocalPlayer.Character

    if not Character then
        return
    end

    local Existing = Character:FindFirstChild(WeightName)

    if Existing then
        Existing:Destroy()
    end

end

CreateOption("ALEKS SPEED GLITCH", function(Enabled)

    AleksEnabled = Enabled

    if Enabled then
        ApplyPhysicsWeight(CurrentWeight)
    else
        RemovePhysicsWeight()
    end

end)

LocalPlayer.CharacterAdded:Connect(function()

    task.wait(1)

    if AleksEnabled and CurrentWeight > 0 then
        ApplyPhysicsWeight(CurrentWeight)
    end

end)

